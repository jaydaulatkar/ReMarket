# Backend Environment Variables Template
# Copy this to Backend/.env and fill in your values

PORT=5000
NODE_ENV=production

# MongoDB Atlas
# Format: mongodb+srv://username:password@cluster.mongodb.net/dbname
MONGO_URI=mongodb+srv://username:password@cluster0.mongodb.net/remarket

# JWT Secret (min 32 characters, use a strong random string)
JWT_SECRET=your-very-secret-key-that-is-at-least-32-characters-long

# Gmail Configuration (optional, only needed for email features)
GMAIL_USER=your-email@gmail.com
GMAIL_PASSWORD=your-app-specific-password
